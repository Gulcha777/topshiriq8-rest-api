                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Books"
        ],
        "summary": "Kitobni to'liq almashtirish",
        "description": "Resursning **to'liq** yangi ko'rinishini yuboring. Yuborilmagan ixtiyoriy maydonlar standart qiymatga qaytadi\n(`genre` bo'sh, `available` true). Bir xil so'rovni takrorlash natijani o'zgartirmaydi (idempotent).",
        "operationId": "replace_book_api_v1_books__book_id__put",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Kitob identifikatori (1 dan boshlanuvchi butun son)",
              "examples": [
                1
              ],
              "title": "Book Id"
            },
            "description": "Kitob identifikatori (1 dan boshlanuvchi butun son)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookRead"
                }
              }
            }
          },
          "400": {
            "description": "Validatsiya xatosi: so'rov ma'lumotlari noto'g'ri",
