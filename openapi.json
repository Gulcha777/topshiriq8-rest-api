{
  "openapi": "3.1.0",
  "info": {
    "title": "Books API",
    "description": "\n**Book** resursi uchun RESTful API (Topshiriq \u21168).\n\n* To'liq CRUD: `GET`, `POST`, `PUT`, `PATCH`, `DELETE`\n* Sahifalash (`page`, `size`), filtrlash va saralash (`sort_by`, `order`)\n* DTO orqali validatsiya: noto'g'ri ma'lumotga **400 Bad Request** qaytadi\n* Yagona xatolik formati (`status`, `error`, `message`, `path`, `errors`)\n* Versiyalash: URL orqali (`/api/v1/...`)\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Lokal server"
    }
  ],
  "paths": {
    "/api/v1/books": {
      "post": {
        "tags": [
          "Books"
        ],
        "summary": "Yangi kitob yaratish",
        "description": "Yangi kitob yaratadi. Muvaffaqiyatda **201 Created** va yangi resurs manzili `Location` sarlavhasida qaytadi.",
        "operationId": "create_book_api_v1_books_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookRead"
                }
              }
            }
          },
          "400": {
            "description": "Validatsiya xatosi: so'rov ma'lumotlari noto'g'ri",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Konflikt: bu ISBN bilan kitob allaqachon mavjud",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Kitoblar ro'yxati (sahifalash, filtr, saralash)",
        "description": "Filtrlangan, saralangan va sahifalangan ro'yxat. Jami soni `X-Total-Count` sarlavhasida ham qaytadi.\n\nSo'ralgan sahifa oxirgisidan keyin bo'lsa, xato emas, bo'sh `items` qaytadi.",
        "operationId": "list_books_api_v1_books_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Sahifa raqami (1 dan boshlanadi)",
              "default": 1,
              "title": "Page"
            },
            "description": "Sahifa raqami (1 dan boshlanadi)"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Sahifadagi elementlar soni (1-100)",
              "default": 10,
              "title": "Size"
            },
            "description": "Sahifadagi elementlar soni (1-100)"
          },
          {
            "name": "title",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nomida shu matn bor (katta-kichik harf farqsiz)",
              "title": "Title"
            },
            "description": "Nomida shu matn bor (katta-kichik harf farqsiz)"
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Muallif nomida shu matn bor (katta-kichik harf farqsiz)",
              "title": "Author"
            },
            "description": "Muallif nomida shu matn bor (katta-kichik harf farqsiz)"
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Aynan shu janr (katta-kichik harf farqsiz)",
              "title": "Genre"
            },
            "description": "Aynan shu janr (katta-kichik harf farqsiz)"
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1450
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nashr yili shundan kam emas",
              "title": "Year From"
            },
            "description": "Nashr yili shundan kam emas"
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1450
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nashr yili shundan ko'p emas",
              "title": "Year To"
            },
            "description": "Nashr yili shundan ko'p emas"
          },
          {
            "name": "available",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mavjudlik: true yoki false",
              "title": "Available"
            },
            "description": "Mavjudlik: true yoki false"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Narx shundan kam emas",
              "title": "Min Price"
            },
            "description": "Narx shundan kam emas"
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0.0
                },
                {
                  "type": "string",
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Narx shundan ko'p emas",
              "title": "Max Price"
            },
            "description": "Narx shundan ko'p emas"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortField",
              "description": "Saralash maydoni",
              "default": "id"
            },
            "description": "Saralash maydoni"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortOrder",
              "description": "Saralash yo'nalishi",
              "default": "asc"
            },
            "description": "Saralash yo'nalishi"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_BookRead_"
                }
              }
            }
          },
          "400": {
            "description": "Validatsiya xatosi: so'rov ma'lumotlari noto'g'ri",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/books/{book_id}": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "Kitobni ID bo'yicha olish",
        "operationId": "get_book_api_v1_books__book_id__get",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Kitob identifikatori (1 dan boshlanuvchi butun son)",
              "examples": [
                1
              ],
              "title": "Book Id"
            },
            "description": "Kitob identifikatori (1 dan boshlanuvchi butun son)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookRead"
