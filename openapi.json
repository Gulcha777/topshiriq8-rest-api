              }
            ],
            "title": "Price",
            "description": "Narx (so'm), 0 dan 999999.99 gacha, kasr qismi ko'pi bilan 2 ta raqam"
          },
          "available": {
            "type": "boolean",
            "title": "Available",
            "default": true
          }
